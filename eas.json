{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "env": { "APP_VARIANT": "development", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.0",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://mila-umber.vercel.app/api/v1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://mila-umber.vercel.app/api/v1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {}
  }
}
