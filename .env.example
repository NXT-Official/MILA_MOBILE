# Copy to .env.local (gitignored) and fill in.
#
# The EXPO_PUBLIC_* values below are PUBLIC BY DESIGN and ship inside the
# binary. Metro inlines every EXPO_PUBLIC_* reference into the JavaScript
# bundle, and a shipped APK can be unzipped by anyone.
#
# No server-only secret belongs in this file. The service-role key, the
# AI/Gemini key, the Cloudflare token, the Paddle keys, and the hCaptcha
# secret exist only on the server. `npm run scan:secrets` fails the build if
# one reaches the bundle or shows up anywhere in git history.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_HCAPTCHA_SITEKEY=

# PostHog — product analytics (see src/services/posthog.ts). Optional: unset
# disables all capture, same pattern as crash reporting below. The project key
# is write-only and public by design — EXPO_PUBLIC_ values ship inside the
# binary. For EAS builds the same values live in eas.json's build profiles.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Populated by running `eas init` against your own Expo account — do not
# fabricate a project ID. See RELEASE-SETUP.md.
EAS_PROJECT_ID=

# Crash reporting (see src/services/crash-reporting.ts). Supply these from
# your own Sentry project; a missing DSN disables reporting rather than
# crashing the app (Sentry.init's `enabled` guard). Not EXPO_PUBLIC_-prefixed:
# SENTRY_ORG/SENTRY_PROJECT are read only by the config plugin at build time
# (source-map/symbol upload), never bundled into the client.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
