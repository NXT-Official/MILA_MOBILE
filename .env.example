# Copy to .env.local (gitignored) and fill in.
#
# These four values are PUBLIC BY DESIGN and ship inside the binary. Metro
# inlines every EXPO_PUBLIC_* reference into the JavaScript bundle, and a
# shipped APK can be unzipped by anyone.
#
# No other variable belongs in this file. The service-role key, the AI/Gemini
# key, the Cloudflare token, the Paddle keys, and the hCaptcha secret exist only
# on the server. `npm run scan:secrets` fails the build if one reaches the
# bundle.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_HCAPTCHA_SITEKEY=
